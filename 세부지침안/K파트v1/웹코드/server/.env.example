# 복사해서 `.env`로 이름을 바꾸고 값을 채워요. `.env`는 git에 올리지 않아요(레포 .gitignore).
# 배포(Vercel)는 이 파일 대신 프로젝트 설정 > Environment Variables 화면에 같은 이름으로 넣어요.
# 값은 절대 문서·채팅·코드에 적지 않아요. 이 파일에는 이름만 있어요.

# ── 서버 전용 (브라우저 코드에 절대 넣지 않음) ─────────────────
GEMINI_API_KEY=                  # K11 챗봇·번역기 (Google AI Studio 무료 키)
SUPABASE_SERVICE_ROLE_KEY=       # 모든 권한 키. 서버 함수에서만
# (카카오 REST 키·Client Secret, 구글 보안 비밀번호는 Supabase 대시보드 Authentication > Providers에 입력해요. 여기에 안 넣어요)
KAKAOPAY_SECRET_KEY=             # K09 카카오페이 (연습: 개발자 센터 테스트용)
KAKAOPAY_CID=TC0ONETIME          # 카카오페이 테스트 가맹점 코드(공개된 테스트 값). 실서비스는 제휴 발급 코드
# ALIMTALK_API_KEY=              # K10 알림톡 발송 대행사 (선택·나중에)
# STAFF_PIN=                     # K10 직원용 관리 화면 접근 번호(MVP는 임시 PIN)

# ── 웹(브라우저)에 노출돼도 되는 공개용 값 ──────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
KAKAO_JS_KEY=                    # 카카오 개발자 사이트에서 허용 도메인(localhost, vercel 주소)을 등록해야 함
GOOGLE_CLIENT_ID=
